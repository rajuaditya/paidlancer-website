# Copy to .env and fill in. Leave blank to disable a feature — nothing is faked when empty.
VITE_SITE_URL=https://paidlancer.in

# Analytics / tracking (scripts load only when an ID is present)
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_GSC_VERIFICATION=

# Forms: any endpoint that accepts JSON POST (Formspree, Web3Forms, Supabase Edge Function, your own API).
# When empty, forms hand the enquiry to WhatsApp / email instead of pretending to submit.
VITE_FORM_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=

# Website Growth Analyzer — Google PageSpeed Insights API key (optional; works without one at a low shared quota)
VITE_PAGESPEED_API_KEY=
